[
  // ===== Workbench navigation, views, and editor windows =====
  {
    "key": "alt+left",
    "command": "workbench.action.navigateBack"
  },
  {
    "key": "alt+right",
    "command": "workbench.action.navigateForward"
  },
  {
    "key": "shift+ctrl+t",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "shift+ctrl+o",
    "command": "workbench.action.openRecent"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.openRecent"
  },
  {
    "key": "shift+ctrl+a",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.view.scm"
  },
  {
    "key": "alt+1",
    "command": "workbench.view.explorer"
  },
  {
    "key": "shift+ctrl+w",
    "command": "workbench.action.closeAllEditors"
  },
  {
    "key": "ctrl+f4",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    "key": "shift+f4",
    "command": "workbench.action.copyEditorToNewWindow"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "markdown.togglePreview"
  },

  // ===== File Explorer =====
  {
    "key": "ctrl+n",
    "command": "explorer.newFile",
    "when": "!terminalFocus"
  },
  {
    "key": "shift+ctrl+n",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus"
  },
  {
    "key": "up",
    "command": "list.focusUp",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "down",
    "command": "list.focusDown",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "space",
    "command": "list.toggleSelection",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+up",
    "command": "runCommands",
    "when": "filesExplorerFocus && !inputFocus",
    "args": {
      "commands": [
        "list.toggleSelection",
        "list.focusUp"
      ]
    }
  },
  {
    "key": "shift+down",
    "command": "runCommands",
    "when": "filesExplorerFocus && !inputFocus",
    "args": {
      "commands": [
        "list.toggleSelection",
        "list.focusDown"
      ]
    }
  },
  {
    "key": "ctrl+space",
    "command": "list.clear",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "ctrl+d",
    "command": "compareSelected",
    "when": "filesExplorerFocus && listDoubleSelection && !inputFocus"
  },

  // ===== Search and code navigation =====
  {
    "key": "ctrl+f",
    "command": "actions.find"
  },
  {
    "key": "f3",
    "command": "editor.action.nextMatchFindAction"
  },
  {
    "key": "shift+f3",
    "command": "editor.action.previousMatchFindAction"
  },
  {
    "key": "shift+ctrl+f",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "shift+ctrl+alt+j",
    "command": "editor.action.addSelectionToNextFindMatch"
  },
  {
    "key": "alt+j",
    "command": "editor.action.addSelectionToNextFindMatch"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.gotoLine"
  },
  {
    "key": "ctrl+f12",
    "command": "workbench.action.gotoSymbol"
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.showAllSymbols"
  },
  {
    "key": "alt+f7",
    "command": "editor.action.referenceSearch.trigger"
  },

  // ===== Editor actions and refactoring =====
  {
    "key": "ctrl+r",
    "command": "editor.action.startFindReplaceAction"
  },
  {
    "key": "shift+ctrl+r",
    "command": "workbench.action.replaceInFiles"
  },
  {
    "key": "ctrl+f6",
    "command": "editor.action.changeAll"
  },
  {
    "key": "shift+ctrl+slash",
    "command": "editor.action.blockComment"
  },
  {
    "key": "ctrl+slash",
    "command": "editor.action.commentLine"
  },
  {
    "key": "shift+ctrl+d",
    "command": "editor.action.deleteLines"
  },
  {
    "key": "ctrl+d",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+ctrl+down",
    "command": "editor.action.moveLinesDownAction"
  },
  {
    "key": "shift+ctrl+up",
    "command": "editor.action.moveLinesUpAction"
  },
  {
    "key": "shift+alt+right",
    "command": "editor.action.smartSelect.expand"
  },
  {
    "key": "shift+alt+left",
    "command": "editor.action.smartSelect.shrink"
  },
  {
    "key": "ctrl+q",
    "command": "editor.action.showHover"
  },
  {
    "key": "ctrl+h",
    "command": "editor.showCallHierarchy"
  },
  {
    "key": "ctrl+alt+c",
    "command": "editor.action.refactor"
  },
  {
    "key": "ctrl+alt+l",
    "command": "editor.action.formatDocument"
  },
  {
    "key": "shift+f6",
    "command": "editor.action.rename"
  },

  // ===== Source control and revert actions =====
  {
    "key": "shift+ctrl+b",
    "command": "git.checkout"
  },
  {
    "key": "ctrl+alt+p",
    "command": "git.fetch"
  },
  {
    "key": "shift+ctrl+p",
    "command": "git.pull"
  },
  {
    "key": "shift+ctrl+k",
    "command": "git.push"
  },
  {
    "key": "ctrl+alt+z",
    "command": "git.revertSelectedRanges",
    "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
  },
  {
    "key": "ctrl+alt+z",
    "command": "git.clean",
    "when": "editorTextFocus && !editorHasSelection && resourceScheme == file"
  },
  {
    "key": "ctrl+alt+z",
    "command": "diffEditor.revert",
    "when": "isInDiffEditor"
  },

  // ===== Tasks, testing, and debugging =====
  {
    "key": "ctrl+f9",
    "command": "workbench.action.tasks.build"
  },
  {
    "key": "shift+ctrl+f5",
    "command": "workbench.action.task.run"
  },
  {
    "key": "shift+ctrl+g",
    "command": "testing.goToRelatedTest"
  },
  {
    "key": "ctrl+f5",
    "command": "workbench.action.debug.run"
  },
  {
    "key": "shift+f5",
    "command": "workbench.action.debug.restart"
  },
  {
    "key": "f9",
    "command": "workbench.action.debug.continue"
  },
  {
    "key": "f7",
    "command": "workbench.action.debug.stepInto"
  },
  {
    "key": "f8",
    "command": "workbench.action.debug.stepOver"
  },
  {
    "key": "shift+f8",
    "command": "workbench.action.debug.stepOut"
  },
  {
    "key": "ctrl+f8",
    "command": "editor.debug.action.toggleBreakpoint"
  },

  // ===== Terminal =====
  {
    "key": "alt+f12",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "alt+f12",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },


  // ===== Copilot Chat =====
  {
    "key": "shift+ctrl+l",
    "command": "copilot.chat.inline"
  },
  {
    "key": "ctrl+l",
    "command": "copilot.chat.show"
  },

  // ===== Focus management =====
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "(sideBarFocus || auxiliaryBarFocus || panelFocus) && !terminalFocus"
  }
]
